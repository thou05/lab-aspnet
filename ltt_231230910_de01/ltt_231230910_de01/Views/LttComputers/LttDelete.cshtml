@model ltt_231230910_de01.Models.LttComputer

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_lttLayout.cshtml";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>LttComputer</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.lttComName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.lttComName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.lttComPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.lttComPrice)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.lttComImage)
        </dt>
        <dd class = "col-sm-10">
            @* @Html.DisplayFor(model => model.lttComImage) *@
            @if (!string.IsNullOrEmpty(Model.lttComImage))
            {
                <img src="~/img/@Model.lttComImage" alt="Computer Image" style="max-width:100px; max-height:100px;" />
            }
        </dd>
        <dt class = "col-sm-2">

            @Html.DisplayNameFor(model => model.lttComStatus)
        </dt>
        <dd class = "col-sm-10">
            @(Model.lttComStatus ? "Còn hàng" : "Hết hàng")
        </dd>
    </dl>
    
    <form asp-action="LttDelete">
        <input type="hidden" asp-for="lttComId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="LttIndex">Back to List</a>
    </form>
</div>
